def teacher_today_attendance():
    date_text, _, _ = get_current_date_and_time()
    print("\n--- Today's Attendance (" + date_text + ") ---")
    rows = []
    for record in attendance:
        if record[5] == date_text and record[4] == current_quarter:
            rows.append([record[6], record[1], record[2], record[3], record[7]])
    if len(rows) == 0:
        print("No attendance has been recorded yet today.")
    else:
        print_table(["Time", "Student", "Section", "Subject", "Status"], rows)




def teacher_attendance_summary():
    print("\n--- Attendance Summary (" + current_quarter + ") ---")
    print(CANCEL_HINT)


    # Step 1: the teacher picks one of the sections that really exist.
    sections = get_attendance_sections()
    if len(sections) == 0:
        print("No sections found yet.")
        return
    pick = choose_option("Choose a section:", sections, "Back",
                         "Invalid choice. Please select one of the available sections.")
    if pick is None:
        return
    section = sections[pick]


    print("\n--- Attendance Summary - " + section + " (" + current_quarter + ") ---")


    # Step 2: a section with no subject/schedule has nothing to summarize.
    # Nobody is counted as Absent just because there is no class.
    section_subjects = []
    for subj in subjects:
        if subj[1] == section:
            section_subjects.append(subj[0])
    if len(section_subjects) == 0:
        print("No subject/schedule is currently assigned to this section.")
        return


    section_students = get_students_in_section(section)
    if len(section_students) == 0:
        print("There are no students in this section.")
        return


    # Step 3: count each student's real records (this section, current quarter).
    print("Subjects: " + ", ".join(section_subjects))
    rows = []
    for s in section_students:
        present_count = 0
        late_count = 0
        absent_count = 0
        excuse_count = 0
        for record in attendance:
            if record[0] != s[0] or record[2] != section or record[4] != current_quarter:
                continue
            if record[7] == "Present":
                present_count = present_count + 1
            elif record[7] == "Late":
                late_count = late_count + 1
            elif record[7] == "Absent":
                absent_count = absent_count + 1
            elif record[7] == "Excuse":
                excuse_count = excuse_count + 1
        total = present_count + late_count + absent_count + excuse_count
        rows.append([s[1], s[0], present_count, late_count, absent_count, excuse_count, total])
    print_table(["Student Name", "Student ID", "Present", "Late", "Absent", "Excuse", "Total Records"], rows)




