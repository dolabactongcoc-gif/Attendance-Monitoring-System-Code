def print_table(headers, rows):
    """Prints a simple text table. Each column is as wide as its longest value."""
    widths = []
    for h in headers:
        widths.append(len(h))
    for row in rows:
        for i in range(len(row)):
            if len(str(row[i])) > widths[i]:
                widths[i] = len(str(row[i]))


    border = "+"
    for w in widths:
        border = border + "-" * (w + 2) + "+"


    header_line = "|"
    for i in range(len(headers)):
        header_line = header_line + " " + headers[i].ljust(widths[i]) + " |"


    print(border)
    print(header_line)
    print(border)
    for row in rows:
        line = "|"
        for i in range(len(row)):
            line = line + " " + str(row[i]).ljust(widths[i]) + " |"
        print(line)
    print(border)




def print_students_table(student_list, numbered=True):
    """Shows students as a table. numbered=False leaves out the No. column
    (used when only one student is shown)."""
    rows = []
    for i in range(len(student_list)):
        s = student_list[i]
        if numbered:
            rows.append([i + 1, s[0], s[1], s[2]])
        else:
            rows.append([s[0], s[1], s[2]])
    if numbered:
        print_table(["No.", "Student ID", "Student Name", "Section"], rows)
    else:
        print_table(["Student ID", "Student Name", "Section"], rows)




