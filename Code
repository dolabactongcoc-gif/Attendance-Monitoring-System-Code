def edit_student(target):
    print("\n--- Edit Student ---")
    print_students_table([target], False)


    while True:
        new_name = ask("Enter new Student Name (press Enter to keep the current name): ")
        if new_name == "":
            new_name = target[1]
            break
        if is_valid_student_name(new_name):
            break
        print("Error: Student Name can only contain letters and spaces. Please try again.")


    new_section = target[2]
    if ask_yes_no("Change the Section? (yes/no): "):
        picked = select_registered_section()
        if picked is not None:
            new_section = picked


    target[1] = new_name
    target[2] = new_section
    print("\nStudent updated successfully.")
    print_students_table([target], False)




def ask_new_section():
    """Asks for a brand-new section name. Asks again until it is valid and not
    already used. Capital letters are applied automatically (fb1-bsit-04 becomes FB1-BSIT-04)."""
    while True:
        section = ask("Enter the new Section (letters, numbers, and hyphens only, e.g. FB1-BSIT-04): ").upper()
        if section == "":
            print("Error: Section cannot be blank. Please try again.")
        elif not is_valid_section_name(section):
            print("Error: Invalid section name. Use only letters, numbers, and hyphens (no spaces or symbols), up to 20 characters.")
        elif section_already_exists(section):
            print("Error: This section already exists. Please enter a different section name.")
        else:
            return section




def add_student():
    print("\n--- Add Student ---")
    print(CANCEL_HINT)


    # Each answer is asked again until it is correct, so a mistake never
    # sends the teacher back to the menu.
    while True:
        student_id = ask("Enter Student ID (e.g. 02-2627-010147): ")
        if not is_valid_student_id(student_id):
            print("Error: Invalid Student ID. Please try again.")
        elif find_student(student_id) is not None:
            print("Error: This Student ID already exists. Please try again.")
        else:
            break


    while True:
        name = ask("Enter Student Name: ")
        if name == "":
            print("Error: Student Name cannot be blank. Please try again.")
        elif not is_valid_student_name(name):
            print("Error: Student Name can only contain letters and spaces. Please try again.")
        else:
            break


    # Pick an existing section from the list, or add a brand-new one.
    existing_sections = get_registered_sections()
    if len(existing_sections) == 0:
        section = ask_new_section()
    else:
        pick = choose_option("Select Section:", existing_sections + ["Add a new section"])
        if pick is None:
            print("Add Student cancelled.")
            return
        if pick == len(existing_sections):
            section = ask_new_section()
        else:
            section = existing_sections[pick]


    students.append([student_id, name, section])
    print("\nStudent successfully added.")
    print_students_table([[student_id, name, section]], False)




def remove_student():
    print("\n--- Remove Student ---")
    print(CANCEL_HINT)
    section = select_registered_section()
    if section is None:
        return


    section_students = get_students_in_section(section)
