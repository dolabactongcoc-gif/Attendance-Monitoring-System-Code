def record_date_key(record):
    return date_sort_key(record[5])




def view_attendance_records():
    print("\n--- View Attendance Records (" + current_quarter + ") ---")
    print(CANCEL_HINT)


    # Section -> Subject -> Date, each picked from a numbered list.
    picked = select_section_and_subject(True)
    if picked is None:
        return
    section, subject_name = picked


    dates = get_record_dates(section, subject_name)
    if len(dates) == 0:
        print("No attendance records found for this selection.")
        return
    pick = choose_option("Select Date:", dates + ["All Dates"])
    if pick is None:
        return
    date_text = None
    if pick < len(dates):
        date_text = dates[pick]


    matches = []
    for record in attendance:
        if record[4] != current_quarter or record[2] != section:
            continue
        if subject_name is not None and record[3] != subject_name:
            continue
        if date_text is not None and record[5] != date_text:
            continue
        matches.append(record)
    matches.sort(key=record_date_key)


    heading = section
    if subject_name is not None:
        heading = heading + " | " + subject_name
    if date_text is not None:
        heading = heading + " | " + date_text
    print("\n--- Attendance Records: " + heading + " ---")
    rows = []
    for record in matches:
        rows.append([record[5], record[6], record[0], record[1], record[3], record[7]])
    print_table(["Date", "Time", "Student ID", "Student", "Subject", "Status"], rows)




def edit_attendance_status():
