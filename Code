def get_students_in_section(section):
    section_students = []
    for s in students:
        if s[2] == section:
            section_students.append(s)
    return section_students




def print_section_students_table(section_students):
    """Students of one section as a numbered table."""
    rows = []
    for i in range(len(section_students)):
        s = section_students[i]
        rows.append([i + 1, s[0], s[1], s[2]])
    print_table(["No.", "Student ID", "Student Name", "Section"], rows)




