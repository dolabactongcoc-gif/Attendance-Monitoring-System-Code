def find_subject(subject_name, section):
    for subj in subjects:
        if subj[0] == subject_name and subj[1] == section:
            return subj
    return None




def get_registered_sections():
    """Every section that has at least one registered student, plus every section
    the teacher created in Add Subject (even if it has no students yet)."""
    sections = []
    for s in students:
        if s[2] not in sections:
            sections.append(s[2])
    for section in created_sections:
        if section not in sections:
            sections.append(section)
    return sections




def select_registered_section():
    """Console 'dropdown': the teacher can only pick from sections that
    already exist, so a section can never be mistyped. Returns the
    section name, or None if the teacher chose Back."""
    sections = get_registered_sections()
    if len(sections) == 0:
        print("No registered sections yet. Add a student first.")
        return None


    pick = choose_option("Select Section:", sections)
    if pick is None:
        return None
    return sections[pick]




def section_already_exists(section):
    """True if this section name is already used (capital letters do not matter)."""
    for existing in get_attendance_sections():
        if existing.upper() == section.upper():
            return True
    for subj in subjects:
        if subj[1].upper() == section.upper():
            return True
    return False




def select_section_for_subject():
    """Pick an existing section from the list, or choose 'Add a new section'.
    Returns (section, is_new_section), or None if the teacher chose Back."""
    existing_sections = get_registered_sections()
    pick = choose_option("Select Section:", existing_sections + ["Add a new section"])
    if pick is None:
        return None
    if pick == len(existing_sections):
        return ask_new_section(), True
    return existing_sections[pick], False




def get_attendance_sections():
    """Registered sections, plus any section that still has saved attendance
    records (for example after all its students were removed)."""
    sections = get_registered_sections()
    for record in attendance:
        if record[2] not in sections:
            sections.append(record[2])
    return sections




def get_attendance_subjects(section):
    """Subjects scheduled for the section, plus any subject that still has
    saved attendance records for it (for example a removed subject)."""
    names = []
    for subj in subjects:
        if subj[1] == section and subj[0] not in names:
            names.append(subj[0])
    for record in attendance:
        if record[2] == section and record[3] not in names:
            names.append(record[3])
    return names




def date_sort_key(date_text):
    return datetime.strptime(date_text, "%B %d, %Y")




def get_record_dates(section, subject_name):
    """Every date (oldest first) that has attendance records in the current
    quarter for this section. subject_name=None means all subjects."""
    dates = []
    for record in attendance:
        if record[4] != current_quarter or record[2] != section:
            continue
        if subject_name is not None and record[3] != subject_name:
            continue
        if record[5] not in dates:
            dates.append(record[5])
    dates.sort(key=date_sort_key)
    return dates




def select_section_and_subject(allow_all_subjects):
    """Teacher picks a Section, then a Subject, from numbered lists.
    Returns (section, subject_name), or None if the teacher chose Back.
    subject_name is None when 'All Subjects' was chosen."""
    sections = get_attendance_sections()
    if len(sections) == 0:
        print("No sections found yet.")
        return None
    pick = choose_option("Select Section:", sections)
    if pick is None:
        return None
    section = sections[pick]


    subject_names = get_attendance_subjects(section)
    if len(subject_names) == 0:
        print("No subjects found for " + section + ".")
        return None
    options = subject_names[:]
    if allow_all_subjects:
        options.append("All Subjects")
    pick = choose_option("Select Subject for " + section + ":", options)
    if pick is None:
        return None
    if allow_all_subjects and pick == len(subject_names):
        return section, None
    return section, subject_names[pick]




def get_students_for_stats(section):
    """Students of the section (id, name), plus removed students who still
    have saved attendance records in that section."""
    people = []
    for s in students:
        if s[2] == section:
            people.append([s[0], s[1]])
    for record in attendance:
        if record[2] != section:
            continue
        known = False
        for p in people:
            if p[0] == record[0]:
                known = True
        if not known:
            people.append([record[0], record[1]])
    return people




def get_tracking_start(subject):
    """The first date this subject is checked for automatic Absent. The
    sample subjects start on ATTENDANCE_START_DATE; a subject added later
    starts the day after it was added."""
    if len(subject) > 6:
        return subject[6]
    return ATTENDANCE_START_DATE




def mark_missing_attendance_absent():
    """Automatic Absent: from ATTENDANCE_START_DATE up to today, every class
    that was scheduled on that weekday and is already more than 90 minutes
    past its start time gets an Absent record for each student in that
    section who never logged in. Records the teacher edits (for example
    Absent -> Excuse) are never touched again."""
    now = datetime.now()
    today = now.date()
    now_minutes = now.hour * 60 + now.minute


    day = ATTENDANCE_START_DATE
    while day <= today:
        date_text = day.strftime("%B %d, %Y")
        day_name = day.strftime("%A")
        for subj in subjects:
            if not is_subject_scheduled_today(subj, day_name):
                continue
            if day < get_tracking_start(subj):
                continue
            session = [date_text, subj[0], subj[1]]
            if session in processed_sessions:
                continue
            # Today's class is only Absent once the 90-minute window is over.
            if day == today and now_minutes <= time_to_minutes(subj[2]) + ABSENT_AFTER_MINUTES:
                continue


            for s in students:
                if s[2] != subj[1]:
                    continue
                has_record = False
                for record in attendance:
                    if record[0] == s[0] and record[3] == subj[0] and record[5] == date_text:
                        has_record = True
                        break
                if not has_record:
                    attendance.append([s[0], s[1], s[2], subj[0],
                                       current_quarter, date_text, "N/A", "Absent"])
            processed_sessions.append(session)
        day = day + timedelta(days=1)




def is_subject_scheduled_today(subject, day_name):
    return day_name in subject[4]




def already_logged_today(student_id, subject_name, date_text, quarter):
    for record in attendance:
        if (record[0] == student_id and record[3] == subject_name
                and record[5] == date_text and record[4] == quarter):
            return record
    return None




