# ==========================================================
#  INPUT HELPERS  (Space = cancel)
# ==========================================================
class CancelInput(Exception):
    """Raised when the user types a Space to cancel what they are doing."""
    pass




CANCEL_HINT = "(Type a Space and press Enter at any time to cancel.)"




def ask(prompt):
    """Works like input(), but if the user types only a Space (then Enter),
    the current process is cancelled. Just pressing Enter still gives a
    blank answer, so 'leave blank for all' and 'press Enter to skip' still work."""
    raw = input(prompt)
    if raw != "" and raw.strip() == "":
        raise CancelInput()
    return raw.strip()




def run_action(action, *args):
    """Runs one menu action. If the user cancels with a Space, we just go
    back to the menu that called it (the program does not close)."""
    try:
        action(*args)
    except CancelInput:
        print("\nCancelled. Returning to the previous menu.")




def choose_option(title, options, back_label="Back", error_text="Invalid choice. Please try again."):
    """Shows a numbered list with a 'Back' option as the last number.
    Keeps asking until the teacher enters a valid number, so a wrong
    answer never leaves the menu. Returns the chosen position in the
    list (0 for the first option), or None if Back was chosen."""
    print("\n" + title)
    for i in range(len(options)):
        print(str(i + 1) + ". " + options[i])
    back_number = len(options) + 1
    print(str(back_number) + ". " + back_label)


    while True:
        raw = ask("Enter your choice: ")
        if raw.isdigit() and 1 <= int(raw) <= back_number:
            number = int(raw)
            if number == back_number:
                return None
            return number - 1
        print(error_text)




def choose_from_table(prompt, count):
    """Used after a numbered table was printed. Keeps asking until the
    teacher enters a number that is in the table. Pressing Enter alone
    goes back (returns None). Otherwise returns the position (0 = first row)."""
    while True:
        raw = ask(prompt)
        if raw == "":
            return None
        if raw.isdigit() and 1 <= int(raw) <= count:
            return int(raw) - 1
        print("Invalid choice. Please try again.")




def ask_yes_no(prompt):
    """Keeps asking until the answer is exactly yes or no. Returns True or False."""
    while True:
        answer = ask(prompt).lower()
        if answer == "yes":
            return True
        if answer == "no":
            return False
        print("Invalid choice. Please type 'yes' or 'no'.")




