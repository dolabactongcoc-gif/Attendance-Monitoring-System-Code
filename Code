def add_subject():
    # Show what's already there first, so the teacher doesn't have to
    # remember or re-check before adding a new one.
    print_subjects_table(subjects, "My Current Classes")


    print("\n--- Add New Subject ---")
    print(CANCEL_HINT)
    while True:
        name = ask("Enter Subject Name: ")
        if name == "":
            print("Error: Subject Name cannot be blank. Please try again.")
            continue


        picked = select_section_for_subject()
        if picked is None:
            return
        section, is_new_section = picked


        if find_subject(name, section) is None:
            break
        print("Error: This subject is already scheduled for that section. Use Edit Subject instead, or try a different subject/section.")


    start_time, end_time, crosses_midnight = ask_start_and_end_time()
    schedule_days = select_schedule_days()


    # 7th field: first date this subject is checked for automatic Absent
    # (the day after it was added).
    tracking_start = datetime.now().date() + timedelta(days=1)
    new_subject = [name, section, start_time, end_time, schedule_days, crosses_midnight, tracking_start]
    subjects.append(new_subject)
    if is_new_section:
        created_sections.append(section)      # saved only now, after the whole subject was entered
        print("\nNew section " + section + " was added.")
    print("\nSubject added successfully.")
    print_subjects_table([new_subject], "New Subject")




def select_existing_subject(action_word):
    """Shows every registered subject in a numbered table and lets the
    teacher pick one by number, so a subject or section that does not
    exist can never be entered. Returns the subject, or None for Back."""
    if len(subjects) == 0:
        print("No subjects added yet.")
        return None
    rows = []
    for i in range(len(subjects)):
        subj = subjects[i]
        time_range = subj[2] + " - " + subj[3]
        if len(subj) > 5 and subj[5]:
            time_range = time_range + " (ends next day)"
        rows.append([i + 1, subj[0], subj[1], format_days(subj[4]), time_range])
    print("\n--- My Current Classes ---")
    print_table(["No.", "Subject", "Section", "Days", "Time"], rows)
    pick = choose_from_table("Enter the number of the subject to " + action_word + " (or press Enter to go back): ",
                             len(subjects))
    if pick is None:
        return None
    return subjects[pick]




def edit_subject():
    print("\n--- Edit Subject ---")
    print(CANCEL_HINT)
    subject = select_existing_subject("edit")
    if subject is None:
        return


    print_subjects_table([subject], "Current Details")


    start_time, end_time, crosses_midnight = ask_start_and_end_time(subject[2], subject[3])


    if ask_yes_no("Change the Class Schedule days? (yes/no): "):
        schedule_days = select_schedule_days(subject[4])
    else:
        schedule_days = subject[4]


    subject[2] = start_time
    subject[3] = end_time
    subject[4] = schedule_days
    # Older subject records may not have this 6th field yet; extend if needed.
    if len(subject) > 5:
        subject[5] = crosses_midnight
    else:
        subject.append(crosses_midnight)


    print("\nSubject updated successfully.")
    print_subjects_table([subject], "Updated Subject")




