def view_statistics():
    print("\n--- View Attendance Statistics (" + current_quarter + ") ---")
    print(CANCEL_HINT)


    sections = get_attendance_sections()
    if len(sections) == 0:
        print("No sections found yet.")
        return
    pick = choose_option("Select Section:", sections)
    if pick is None:
        return
    section = sections[pick]


    people = get_students_for_stats(section)
    if len(people) == 0:
        print("No students found in " + section + ".")
        return
    print("\n--- Students in " + section + " ---")
    rows = []
    for i in range(len(people)):
        rows.append([i + 1, people[i][0], people[i][1]])
    print_table(["No.", "Student ID", "Student Name"], rows)


    pick = choose_from_table("Enter the number of the student to view (or press Enter to go back): ",
                             len(people))
    if pick is None:
        return
    student_id = people[pick][0]
    display_name = people[pick][1]


    student_records = []
    for record in attendance:
        if record[0] == student_id and record[4] == current_quarter:
            student_records.append(record)
    student_records.sort(key=record_date_key)


    # The student may have been removed from the active roster -- the
    # section picked above is then used for display.
    student = find_student(student_id)
    if student is not None:
        display_section = student[2]
    else:
        display_section = section


    present_count = 0
    late_count = 0
    excuse_count = 0
    absent_count = 0
    for record in student_records:
        if record[7] == "Present":
            present_count = present_count + 1
        elif record[7] == "Late":
            late_count = late_count + 1
        elif record[7] == "Excuse":
            excuse_count = excuse_count + 1
        elif record[7] == "Absent":
            absent_count = absent_count + 1


    total = present_count + late_count + excuse_count + absent_count
    print("\nStudent:", display_name)
    print("Section:", display_section)
    print("Quarter:", current_quarter)
    print_table(["Status", "Total"], [
        ["Present", present_count],
        ["Late", late_count],
        ["Excuse", excuse_count],
        ["Absent", absent_count],
        ["All Attendance Records", total],
    ])


    if total > 0:
        print("\n--- Detailed Attendance History ---")
        rows = []
        for record in student_records:
            rows.append([record[5], record[6], record[3], record[7]])
        print_table(["Date", "Time", "Subject", "Status"], rows)




