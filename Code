def is_valid_student_id(id_text):
    """
    Matches the required format: 02-2627-010147
    14 characters total: 2 digits, '-', 4 digits, '-', 6 digits.
    """
    if len(id_text) != 14:
        return False
    if id_text[2] != "-" or id_text[7] != "-":
        return False
    part1 = id_text[0:2]
    part2 = id_text[3:7]
    part3 = id_text[8:14]
    return part1.isdigit() and part2.isdigit() and part3.isdigit()


def is_valid_student_name(name_text):
    """
    A student name may only contain letters and normal spaces.
    Numbers and symbols (such as @ # . , -) are not allowed.
    Example: Juan Dela Cruz
    """
    for ch in name_text:
        if ch != " " and not ch.isalpha():
            return False
    return True




def is_valid_section_name(section_text):
    """
    A section name may only contain letters, numbers, and hyphens (no spaces or
    symbols), for example FB1-BSIT-04. It cannot start or end with a hyphen, cannot
    have two hyphens in a row, and can be at most 20 characters long.
    """
    allowed = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-"
    if section_text == "" or len(section_text) > 20:
        return False
    if section_text.startswith("-") or section_text.endswith("-") or "--" in section_text:
        return False
    for ch in section_text:
        if ch not in allowed:
            return False
    return True




def is_valid_time(t):
    """Strict 'HH:MM AM/PM' format only, e.g. '08:00 AM'."""
    if len(t) != 8:
        return False
    if t[2] != ":" or t[5] != " ":
        return False
    hour_text = t[0:2]
    min_text = t[3:5]
    ampm = t[6:8]
    if not (hour_text.isdigit() and min_text.isdigit()):
        return False
    hour = int(hour_text)
    minute = int(min_text)
    if hour < 1 or hour > 12:
        return False
    if minute < 0 or minute > 59:
        return False
    if ampm != "AM" and ampm != "PM":
        return False
    return True




def time_to_minutes(t):
    """Converts an already-validated 'HH:MM AM/PM' string to minutes since midnight."""
    hour = int(t[0:2])
    minute = int(t[3:5])
    ampm = t[6:8]
    if ampm == "AM" and hour == 12:
        hour = 0
    elif ampm == "PM" and hour != 12:
        hour = hour + 12
    return hour * 60 + minute




def get_current_date_and_time():
    now = datetime.now()
    date_text = now.strftime("%B %d, %Y")
    time_text = now.strftime("%I:%M %p")
    day_name = now.strftime("%A")
    return date_text, time_text, day_name




def compute_status(class_start, login_time):
    """Present = on time or within the grace period (<= 15 min late).
    Late = more than 15 min late, up to and including 90 min late.
    Absent = more than 90 min (1 hr 30 min) late.
    This is only ever called once we already know the class has started,
    so the difference here will never be negative."""
    start_minutes = time_to_minutes(class_start)
    login_minutes = time_to_minutes(login_time)
    difference = login_minutes - start_minutes
    if difference <= LATE_AFTER_MINUTES:
        return "Present"
    elif difference <= ABSENT_AFTER_MINUTES:
        return "Late"
    else:
        return "Absent"




def select_schedule_days(current_days=None):
    """Console 'dropdown': the teacher can only pick from the 7 real
    weekdays by number, so free text like 'Hello' can never be saved
    as a schedule."""
    print("\nSelect Class Schedule (choose one or more days):")
    for i in range(len(VALID_DAYS)):
        mark = ""
        if current_days is not None and VALID_DAYS[i] in current_days:
            mark = "  [currently selected]"
        print(str(i + 1) + ". " + VALID_DAYS[i] + mark)


    while True:
        raw = ask("Enter the numbers separated by commas (e.g. 1,3): ")
        pieces = raw.split(",")
        selected = []
        valid_entry = True
        for piece in pieces:
            piece = piece.strip()
            if not piece.isdigit():
                valid_entry = False
                break
            number = int(piece)
            if number < 1 or number > 7:
                valid_entry = False
                break
            day_name = VALID_DAYS[number - 1]
            if day_name not in selected:
                selected.append(day_name)


        if not valid_entry or len(selected) == 0:
            print("Invalid selection. Please enter numbers from 1 to 7, separated by commas (e.g. 1,3).")
            continue
        return selected




def format_days(day_list):
    return ", ".join(day_list)




def ask_start_and_end_time(existing_start=None, existing_end=None):
    """Prompts for a Start Time and End Time, validating the format and
    the logical order between them. Supports classes that cross midnight
    (e.g. 10:30 PM -> 12:00 AM) by asking the teacher to confirm that
    case explicitly, instead of silently guessing either way.
    Returns (start_time, end_time, crosses_midnight)."""
    start_prompt = "Enter Start Time (HH:MM AM/PM): "
    end_prompt = "Enter End Time (HH:MM AM/PM): "
    if existing_start is not None:
        start_prompt = "Enter new Start Time (HH:MM AM/PM), current is " + existing_start + ": "
        end_prompt = "Enter new End Time (HH:MM AM/PM), current is " + existing_end + ": "


    while True:
        start_time = ask(start_prompt)
        if is_valid_time(start_time):
            break
        print("Invalid time format. Please enter a valid time using HH:MM AM/PM format. Example: 10:30 AM.")


    while True:
        end_time = ask(end_prompt)
        if not is_valid_time(end_time):
            print("Invalid time format. Please enter a valid time using HH:MM AM/PM format. Example: 10:30 AM.")
            continue


        start_minutes = time_to_minutes(start_time)
        end_minutes = time_to_minutes(end_time)


        if end_minutes > start_minutes:
            # Normal, same-day class. No extra questions needed.
            return start_time, end_time, False


        # End Time is not after Start Time -- this could be a genuine
        # overnight class (10:30 PM -> 12:00 AM) or a real mistake.
        # Ask instead of silently assuming either way.
        print("The End Time (" + end_time + ") is not after the Start Time (" + start_time + ").")
        confirm = ask("Does this class end after midnight, on the next day? (yes/no): ").lower()
        if confirm == "yes":
            return start_time, end_time, True
        else:
            print("Invalid class schedule. The End Time must be after the Start Time.")
            # loop back and ask for the End Time again




