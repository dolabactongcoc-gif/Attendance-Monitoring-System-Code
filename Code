def attendance_today(student):
    """Shows the subjects registered for this student's section as a table.
    The student picks a subject to check their attendance for it."""
    mark_missing_attendance_absent()
    date_text, _, _ = get_current_date_and_time()


    print("\n--- Today's Attendance (" + date_text + ") ---")
    my_subjects = []
    for subj in subjects:
        if subj[1] == student[2]:
            my_subjects.append(subj)


    if len(my_subjects) == 0:
        print("No subjects are registered for your section yet.")
        return


    rows = []
    for i in range(len(my_subjects)):
        subj = my_subjects[i]
        existing = already_logged_today(student[0], subj[0], date_text, current_quarter)
        if existing is not None:
            status_text = existing[7]
        else:
            status_text = "Check Attendance"
        rows.append([i + 1, subj[0], subj[1], status_text])
    print_table(["No.", "Subject", "Section", "Status"], rows)


    print("\n" + CANCEL_HINT)
    while True:
        pick = ask("Enter the number of the subject to check attendance (or press Enter to go back): ")
        if pick == "":
            return
        if pick.isdigit() and 1 <= int(pick) <= len(my_subjects):
            break
        print("Invalid selection. Please try again.")


    log_student_attendance(student, my_subjects[int(pick) - 1][0])




def log_student_attendance(student, subject_name):
    # Step 1: subject + section must exactly match a real, scheduled class.
    subject = find_subject(subject_name, student[2])
    if subject is None:
        print("No matching section or subject was found. Please check your information and try again.")
        return


    # The date and time always come from the computer's clock -- the
    # student can never type or choose them.
    date_text, time_text, day_name = get_current_date_and_time()


    # Step 2: is this subject even scheduled today? If not, stop here --
    # never create a record and never mark the student Absent.
    if not is_subject_scheduled_today(subject, day_name):
        print("You do not have a class for this subject today.")
        return


    # Step 3: was attendance for this class already recorded today?
    existing = already_logged_today(student[0], subject_name, date_text, current_quarter)
    if existing is not None:
        print("Your attendance for this class has already been recorded today.")
        print("Status:", existing[7])
        return


    # Step 4: has the class actually started yet? If not, do not mark
    # Absent and do not create a record -- just tell them to come back.
    if time_to_minutes(time_text) < time_to_minutes(subject[2]):
        print("You are too early. Your class starts at " + subject[2] + ".")
        return


    # Step 5: only now do we calculate Present / Late / Absent.
    status = compute_status(subject[2], time_text)
    attendance.append([student[0], student[1], student[2], subject_name,
                        current_quarter, date_text, time_text, status])
    print("\nAttendance recorded!")
    print("Subject:", subject_name)
    print("Section:", student[2])
    print("Date:", date_text)
    print("Time:", time_text)
    print("Quarter:", current_quarter)
    print("Status:", status)




