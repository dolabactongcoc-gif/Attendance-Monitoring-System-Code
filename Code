def confirm_remove_student(target):
    print("\nYou are about to remove:")
    print_students_table([target], False)
    print("Are you sure you want to remove this student?")
    if ask_yes_no("Type 'yes' to confirm or 'no' to cancel: "):
        # Historical attendance records are intentionally left untouched here --
        # removing a student only takes them off the active roster (see view_statistics,
        # which still shows their past records using the name/section saved on each record).
        students.remove(target)
        print("Student removed from the active list. Their attendance history remains saved.")
    else:
        print("Remove cancelled.")




